# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Deux projets sont utilisés : un Preview pour le dev, un Production.
# Les références exactes (project ref + URLs) sont partagées via 1Password
# ou directement par un mainteneur — pas commit dans ce repo public.
# En prod, configurer via Vercel Environment Variables (Production scope).
# Les nouvelles clés Supabase (sb_publishable_xxx / sb_secret_xxx) sont
# compatibles avec @supabase/supabase-js sans changement de code.

# Côté client (préfixe NEXT_PUBLIC_ : exposé dans le bundle JS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur UNIQUEMENT (jamais exposé au client).
# Bypass RLS — à protéger comme un mot de passe.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# URL canonique. En local : http://localhost:3000. En prod : https://app.notionclub.fr.
# En preview Vercel : laisser vide → fallback automatique sur l'origine de la requête.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Resend (emails transactionnels)
# ─────────────────────────────────────────────────────────────────────────────
# Compte Resend partagé entre preview et prod (Resend = une seule clé).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@notionclub.fr
# Important : tous les envois doivent inclure le header Reply-To pointant ici.
RESEND_REPLY_TO_EMAIL=theo@gouman.fr

# ─────────────────────────────────────────────────────────────────────────────
# Notion sync (Brique 4 — OPS-18)
# ─────────────────────────────────────────────────────────────────────────────
# Integration interne créée sur https://www.notion.so/profile/integrations.
NOTION_API_TOKEN=
# Secret de vérification HMAC des webhooks Notion → server.
# Générer via : openssl rand -hex 32
NOTION_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron (Brique 1 — OPS-19)
# ─────────────────────────────────────────────────────────────────────────────
# Secret partagé pour authentifier les appels cron entrants.
# Générer via : openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Outil de feedback admin (widget intégré, routes /api/feedback,
# /api/tickets, /api/blog-posts)
# ─────────────────────────────────────────────────────────────────────────────
# Code repris tel quel de theogouman/random-project — les noms de variables
# d'env sont ceux du code source d'origine. À ne pas confondre avec
# NOTION_API_TOKEN ci-dessus (intégration Notion sync, Brique 4) : il s'agit
# bien d'une seconde intégration Notion, dédiée à l'écriture dans la base
# "ticket roadmap" jointe par l'administrateur.
#
# AMBIGUÏTÉ — non résolue :
#   - Faut-il fusionner NOTION_TOKEN avec NOTION_API_TOKEN (une seule
#     intégration partagée) ou garder deux intégrations distinctes ?
#   - La même base est-elle utilisée pour /api/feedback ET /api/blog-posts,
#     ou faut-il deux bases séparées ?
NOTION_TOKEN=
# DB Notion ciblée par /api/feedback (POST) et /api/tickets (GET, DELETE).
# Champs attendus dans la base (cf. app/api/feedback/route.ts) :
#   Ticket (title), Statut (select), Action (select), Élément ciblé (rich_text),
#   Page concernée (select), Retour client (rich_text), Date soumission (date),
#   Session ID (rich_text), URL (url).
NOTION_DATABASE_ID=
# DB Notion ciblée par /api/blog-posts (POST). Si non défini, le code source
# retombe sur la valeur en dur "ca0b4df233c54095917cb3ea38bc59a0" (DB Mireille).
# Base jointe par l'administrateur (URL fournie en session) — à confirmer :
#   c4209ec9-5e2b-4968-88c8-43e6c4672eda
# Champs attendus (cf. app/api/blog-posts/route.ts) :
#   Titre (title), Statut (select), Slug, Extrait, Catégorie (select),
#   Tags (multi_select), Image cover (url), Auteur, Date de publication (date),
#   Temps de lecture (min) (number), Meta description SEO, Corps.
NOTION_BLOG_DATABASE_ID=
