# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Deux projets sont utilisés : un Preview pour le dev, un Production.
# Les références exactes (project ref + URLs) sont partagées via 1Password
# ou directement par un mainteneur — pas commit dans ce repo public.
# En prod, configurer via Vercel Environment Variables (Production scope).
# Les nouvelles clés Supabase (sb_publishable_xxx / sb_secret_xxx) sont
# compatibles avec @supabase/supabase-js sans changement de code.

# Côté client (préfixe NEXT_PUBLIC_ : exposé dans le bundle JS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur UNIQUEMENT (jamais exposé au client).
# Bypass RLS — à protéger comme un mot de passe.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# URL canonique. En local : http://localhost:3000. En prod : https://app.notionclub.fr.
# En preview Vercel : laisser vide → fallback automatique sur l'origine de la requête.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Resend (emails transactionnels)
# ─────────────────────────────────────────────────────────────────────────────
# Compte Resend partagé entre preview et prod (Resend = une seule clé).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@notionclub.fr
# Important : tous les envois doivent inclure le header Reply-To pointant ici.
RESEND_REPLY_TO_EMAIL=theo@gouman.fr

# ─────────────────────────────────────────────────────────────────────────────
# Notion sync (Brique 4 — OPS-18)
# ─────────────────────────────────────────────────────────────────────────────
# Integration interne créée sur https://www.notion.so/profile/integrations.
NOTION_API_TOKEN=
# Secret de vérification HMAC des webhooks Notion → server.
# Générer via : openssl rand -hex 32
NOTION_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron (Brique 1 — OPS-19)
# ─────────────────────────────────────────────────────────────────────────────
# Secret partagé pour authentifier les appels cron entrants.
# Générer via : openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Outil de feedback admin (widget intégré, routes /api/feedback,
# /api/tickets, /api/blog-posts)
# ─────────────────────────────────────────────────────────────────────────────
# Les 3 routes consomment NOTION_API_TOKEN ci-dessus — pas de second token.
# La base cible est la "ticket roadmap" jointe par l'administrateur :
#   ID en dur dans le code = c4209ec9-5e2b-4968-88c8-43e6c4672eda
# L'intégration Notion correspondante doit être connectée à cette base
# (Notion → "..." → Connections → ajouter l'intégration NotionClub).
#
# Overrides optionnels (laisser vide en local, utile en preview/staging) :
NOTION_DATABASE_ID=
NOTION_BLOG_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Notion Membres (DB pour le mapping UUID Supabase ↔ Notion page)
# ─────────────────────────────────────────────────────────────────────────────
# Au signup, une page est créée dans cette DB avec :
#   - Name (title) = "{prénom} {nom}" ou email à défaut
#   - Email        = email
#   - UUID         = profiles.id Supabase
# L'intégration NOTION_API_TOKEN doit être connectée à cette DB.
# Si la variable est absente, l'étape Notion est skippée silencieusement
# (le signup réussit quand même).
NOTION_MEMBERS_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Notion Appels de suivi (DB des coachings, lecture live par /coaching)
# ─────────────────────────────────────────────────────────────────────────────
# Lecture des appels du user depuis cette DB, filtrés par relation Membre.
# Schema attendu (noms exacts cf. src/modules/coaching/server/notion.ts) :
#   - Nom              (title)     — sujet de l'appel
#   - Membre           (relation)  — vers DB Membres (NOTION_MEMBERS_DATABASE_ID)
#   - Date             (date)      — créneau du call
#   - Coach            (select)    — Théo / Noah
#   - Statut           (select)    — À venir / Accepté / No-show / Annulé
#   - Résumé           (rich_text) — résumé Notion AI ou édité main
#   - URL Fathom       (url)       — lien externe Fathom (optionnel)
# Le contenu de la page (blocs Notion) sert de transcription, rendu inline
# via NotionBlocks au clic "Voir la transcription".
# L'intégration NOTION_API_TOKEN doit être connectée à cette DB ET aux pages
# qui y sont stockées. Si la variable est absente : les sections "appels"
# sont vides (best-effort, pas de crash).
NOTION_CALLS_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Transcriptions d'appels — clé HMAC pour les URLs publiques
# ─────────────────────────────────────────────────────────────────────────────
# Les boutons "Demander à ChatGPT / Claude" sur /coaching embarquent un lien
# vers /api/coaching/transcript/<token>. Le token est signé HMAC-SHA256 avec
# cette clé (server-side) et expire en 24h. ChatGPT/Claude suivent le lien et
# lisent la transcription brute en text/plain.
#
# Générer une clé robuste : `openssl rand -hex 32`
# ⚠️ Ne PAS réutiliser FILLOUT_SIGNING_KEY — séparation des responsabilités,
#    rotation indépendante.
# Si absente côté server : signTranscriptToken throw, les boutons ChatGPT/Claude
# sont masqués côté UI (best-effort, pas de crash).
TRANSCRIPT_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Fillout (formulaires intégrés — page /coaching)
# ─────────────────────────────────────────────────────────────────────────────
# URLs complètes des formulaires (domaine custom Fillout `gouman.fillout.com`).
# La modale FilloutModal y ajoute les params id/mail/prenom/nom au clic Réserver.
# Préfixe NEXT_PUBLIC_ car consommés côté client.
# Si vides : fallback sur l'URL coaching pour ne pas crasher le dev local.
#
# Côté Fillout, le formulaire coaching (formId 1XNPkBy855us) attend 4 URL params
# configurés en Settings → URL parameters : id, mail, prenom, nom.
NEXT_PUBLIC_FILLOUT_COACHING_URL=https://gouman.fillout.com/coaching
NEXT_PUBLIC_FILLOUT_SALES_URL=

# Clés API Fillout (server-only — utilisées par d'éventuels scripts admin).
# Pas nécessaire pour le flow réservation V1 (qui passe juste par les URL params),
# mais utile si on génère des liens en batch un jour ou pour debug API.
FILLOUT_API_KEY=
FILLOUT_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Web Push (PWA notifications — module @/shared/lib/push)
# ─────────────────────────────────────────────────────────────────────────────
# Génération initiale (une fois) :
#   npx web-push generate-vapid-keys
#
# 3 variables :
#   - NEXT_PUBLIC_VAPID_PUBLIC_KEY : exposée au navigateur (préfixe NEXT_PUBLIC_),
#     consommée par PushManager.subscribe({ applicationServerKey }).
#   - VAPID_PRIVATE_KEY            : SERVER ONLY, signe chaque push envoyé.
#   - VAPID_SUBJECT                : mailto: ou https:// — point de contact si
#     un push abuse. Fallback hardcodé sur mailto:theo@gouman.fr si absente.
#
# Sans ces variables, le toggle Push dans Réglages est désactivé proprement
# côté UI (cf. usePushSubscription.ts → reason: "no_vapid_key").
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:theo@gouman.fr
